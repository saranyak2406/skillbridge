# SkillBridge Global Environment Template
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillbridge_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secrets
JWT_SECRET=skillbridge_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Client Configuration
CLIENT_URL=http://localhost:5173

# File Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=50
